+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        android:layout_marginTop="4dp"
+        android:ellipsize="end"
+        android:gravity="center"
+        android:maxLines="1"
+        android:textSize="13sp" />
+
+    <!-- 控制按钮: 上一句 / 播放暂停 / 下一句 / 关闭 -->
+    <LinearLayout
+        android:id="@+id/ll_lyrics_controls"
+        android:layout_width="wrap_content"
+        android:layout_height="wrap_content"
+        android:layout_gravity="center_horizontal"
+        android:layout_marginTop="2dp"
+        android:orientation="horizontal">
+
+        <ImageButton
+            android:id="@+id/iv_lyrics_prev"
+            android:layout_width="40dp"
+            android:layout_height="40dp"
+            android:background="@android:color/transparent"
+            android:contentDescription="@string/read_aloud_lyrics_prev"
+            android:padding="9dp"
+            android:scaleType="centerInside"
+            android:src="@drawable/ic_skip_previous" />
+
+        <ImageButton
+            android:id="@+id/iv_lyrics_play"
+            android:layout_width="40dp"
+            android:layout_height="40dp"
+            android:background="@android:color/transparent"
+            android:contentDescription="@string/read_aloud_lyrics_play"
+            android:padding="9dp"
+            android:scaleType="centerInside"
+            android:src="@drawable/ic_pause_24dp" />
+
+        <ImageButton
+            android:id="@+id/iv_lyrics_next"
+            android:layout_width="40dp"
+            android:layout_height="40dp"
+            android:background="@android:color/transparent"
+            android:contentDescription="@string/read_aloud_lyrics_next"
+            android:padding="9dp"
+            android:scaleType="centerInside"
+            android:src="@drawable/ic_skip_next" />
+
+        <ImageButton
+            android:id="@+id/iv_lyrics_close"
+            android:layout_width="40dp"
+            android:layout_height="40dp"
+            android:background="@android:color/transparent"
+            android:contentDescription="@string/read_aloud_lyrics_close"
+            android:padding="9dp"
+            android:scaleType="centerInside"
+            android:src="@drawable/ic_baseline_close" />
+    </LinearLayout>
+</LinearLayout>
