+/*
+ * OLED 纯黑主题：在 element-plus 暗色变量基础上再压到真黑，
+ * 并整体提亮文字，解决「默认暗色太灰、白天看不清」的问题。
+ */
+html.oled.dark {
+  color-scheme: dark;
+
+  --el-bg-color: #000000;
+  --el-bg-color-page: #000000;
+  --el-bg-color-overlay: #0a0a0a;
+
+  --el-fill-color: #101010;
+  --el-fill-color-light: #161616;
+  --el-fill-color-lighter: #1b1b1b;
+  --el-fill-color-extra-light: #202020;
+  --el-fill-color-dark: #0c0c0c;
+  --el-fill-color-darker: #080808;
+  --el-fill-color-blank: #000000;
+
+  --el-text-color-primary: #f2f2f2;
+  --el-text-color-regular: #dcdcdc;
+  --el-text-color-secondary: #adadad;
+  --el-text-color-placeholder: #7d7d7d;
+  --el-text-color-disabled: #5a5a5a;
+
+  --el-border-color: #2a2a2a;
+  --el-border-color-light: #242424;
+  --el-border-color-lighter: #1e1e1e;
+  --el-border-color-extra-light: #181818;
+  --el-border-color-dark: #333333;
+  --el-border-color-darker: #3a3a3a;
+
+  --el-box-shadow: 0 12px 32px 4px rgba(0, 0, 0, 0.6);
+  --el-box-shadow-light: 0 0 12px rgba(0, 0, 0, 0.7);
+  --el-box-shadow-lighter: 0 0 8px rgba(0, 0, 0, 0.6);
+  --el-box-shadow-dark: 0 16px 48px 16px rgba(0, 0, 0, 0.8);
+}
+
+html.oled,
+html.oled body {
+  background: #000000 !important;
+}
