+        android:layout_height="wrap_content"
+        android:layout_marginTop="4dp"
+        android:ellipsize="end"
+        android:gravity="center"
+        android:lineSpacingExtra="3dp"
+        android:maxLines="3"
+        android:textSize="20sp"
+        android:textStyle="bold" />
+
+    <!-- 下一句(淡) -->
+    <TextView
