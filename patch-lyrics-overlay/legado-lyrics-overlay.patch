+    private fun publishLyrics(force: Boolean = false) {
+        val window = lyricsWindow ?: return
+        if (!window.isEnabled()) return
+        val now = SystemClock.elapsedRealtime()
+        if (!force && now - lyricsProgressStamp < LYRICS_THROTTLE_MS) return
+        lyricsProgressStamp = now
+        if (Looper.myLooper() == Looper.getMainLooper()) {
+            doPublishLyrics(window, force)
+        } else {
